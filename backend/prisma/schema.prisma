  drawings_url            String?
  scope_description       String?                   @db.Text
  approved_by             String?                   @db.VarChar(255)
  approved_at             DateTime?                 @db.Timestamptz(6)
  inspection_notes        String?                   @db.Text
  notes                   String?
  created_at              DateTime?                 @default(now()) @db.Timestamptz(6)
  updated_at              DateTime?                 @default(now()) @db.Timestamptz(6)
  apartments              apartments                @relation(fields: [apartment_id], references: [id], onDelete: Cascade)
  contracts               contracts?                @relation(fields: [contract_id], references: [id], onDelete: Cascade)
  construction_workers    construction_workers[]
  construction_violations construction_violations[]

  @@index([apartment_id])
  @@index([contract_id])
  @@index([status])
  @@index([deposit_status])
}

model construction_workers {
  id                         String                     @id @db.VarChar(255)
  registration_id            String                     @db.VarChar(255)
  full_name                  String                     @db.VarChar(255)
  id_number                  String?                    @db.VarChar(50)
  phone                      String?                    @db.VarChar(50)
  pass_code                  String                     @unique @db.VarChar(100)
  role                       String?                    @default("THO_CHINH") @db.VarChar(100) // CHI_HUY, THO_DIEN, THO_NUOC, THO_NE, THO_SON, THO_MOC
  photo_url                  String?
  valid_from                 DateTime                   @db.Date
  valid_to                   DateTime                   @db.Date
  status                     String                     @default("ACTIVE") @db.VarChar(50) // ACTIVE, REVOKED, EXPIRED
  created_at                 DateTime?                  @default(now()) @db.Timestamptz(6)
  construction_registrations construction_registrations @relation(fields: [registration_id], references: [id], onDelete: Cascade)

  @@index([registration_id])
  @@index([pass_code])
  @@index([status])
}

model construction_violations {
  id                         String                     @id @db.VarChar(255)
  registration_id            String                     @db.VarChar(255)
  violation_code             String                     @unique @db.VarChar(100)
  violation_type             String                     @db.VarChar(100) // SAI_HANG_MUC, THIEU_PCCC, CAU_MAC_DIEN, KHONG_BAO_HO, KHONG_GIAM_SAT, HAN_KHONG_PHEP, TIENG_ON_NGOAI_GIO, VI_PHAM_KHAC
  fine_amount                Decimal                    @default(0) @db.Decimal(15, 2)
  penalty_date               DateTime                   @default(now()) @db.Timestamptz(6)
  description                String                     @db.Text
  photo_urls                 String[]                   @default([])
  recorded_by                String?                    @db.VarChar(255)
  deducted                   Boolean                    @default(true)
  notes                      String?
  created_at                 DateTime?                  @default(now()) @db.Timestamptz(6)
  construction_registrations construction_registrations @relation(fields: [registration_id], references: [id], onDelete: Cascade)

  @@index([registration_id])
  @@index([violation_type])
}

model project_phases {
  id            String      @id @db.VarChar(255)
  phase_code    String      @unique @db.VarChar(50)
  phase_name    String      @db.VarChar(255)
  description   String?     @db.Text
  total_units   Int?        @default(0)
  display_order Int?        @default(0)
  is_active     Boolean     @default(true)
  created_at    DateTime?   @default(now()) @db.Timestamptz(6)
  updated_at    DateTime?   @default(now()) @db.Timestamptz(6)

  @@index([phase_code])
  @@index([is_active])
}

// ===================== RBAC (Blueprint A.4 + E.1) =====================
model roles {
  code        String             @id @db.VarChar(32)
  name        String             @db.VarChar(128)
  subsystem   String             @default("chung") @db.VarChar(32)
  description String?
  is_system   Boolean            @default(true)
  created_at  DateTime           @default(now()) @db.Timestamptz(6)
  userRoles   user_roles[]
  rolePerms   role_permissions[]
}

model user_roles {
  user_id   String @db.VarChar(255)
  role_code String @db.VarChar(32)
  users     users  @relation(fields: [user_id], references: [id], onDelete: Cascade)
  roles     roles  @relation(fields: [role_code], references: [code], onDelete: Cascade)

  @@id([user_id, role_code])
  @@index([role_code])
}

model role_permissions {
  role_code String @db.VarChar(32)
  module    String @db.VarChar(64)
  action    String @db.VarChar(4)
  roles     roles  @relation(fields: [role_code], references: [code], onDelete: Cascade)

  @@id([role_code, module, action])
  @@index([role_code])
}

