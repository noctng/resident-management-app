generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model activity_logs {
  id          String    @id @db.VarChar(255)
  user_id     String?   @db.VarChar(255)
  username    String?   @db.VarChar(255)
  action      String?   @db.VarChar(50)
  target_type String?   @db.VarChar(50)
  target_id   String?   @db.VarChar(255)
  target_name String?   @db.VarChar(255)
  details     String?
  ip_address  String?   @db.VarChar(45)
  http_method String?   @db.VarChar(10)
  http_path   String?   @db.VarChar(500)
  status_code Int?
  old_value   Json?
  new_value   Json?
  user_agent  String?   @db.VarChar(255)
  created_at  DateTime? @default(now()) @db.Timestamptz(6)

  @@index([user_id])
  @@index([created_at])
  @@index([action])
  @@index([target_type])
}

model amenity_usage {
  id           String       @id @db.VarChar(255)
  apartment_id String       @db.VarChar(255)
  amenity      amenity_type
  usage_date   DateTime     @default(dbgenerated("CURRENT_DATE")) @db.Date
  start_time   DateTime?    @db.Timestamp(6)
  end_time     DateTime?    @db.Timestamp(6)
  booking_code String?      @db.VarChar(50)
  status       String?      @default("pending") @db.VarChar(20)
  resident_id  String?      @db.VarChar(255)
  apartments   apartments   @relation(fields: [apartment_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  residents    residents?   @relation(fields: [resident_id], references: [id], onUpdate: NoAction, map: "fk_amenity_resident")

  @@index([apartment_id, usage_date], map: "idx_amenity_usage_apartment_date")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model apartments {
  id                            String              @id @default(dbgenerated("('apt_'::text || lpad((nextval('apartments_id_seq'::regclass))::text, 4, '0'::text))")) @db.VarChar(255)
  house_type                    String              @db.VarChar(50)
  code                          String              @unique @db.VarChar(255)
  floor                         Int
  area                          Decimal             @db.Decimal(10, 2)
  electricity_type              String              @default("RESIDENTIAL") @db.VarChar(20)
  phase_code                    String?             @default("CANTATA") @db.VarChar(50)
  block_code                    String?             @db.VarChar(50)
  lot_number                    String?             @db.VarChar(50)
  land_area                     Decimal?            @db.Decimal(10, 2)
  construction_area             Decimal?            @db.Decimal(10, 2)
  usable_area                   Decimal?            @db.Decimal(10, 2)
  certificate_area              Decimal?            @db.Decimal(10, 2)
  land_price_before_vat         Decimal?            @default(0) @db.Decimal(15, 2)
  construction_price_before_vat Decimal?            @default(0) @db.Decimal(15, 2)
  vat_rate                      Decimal?            @default(8.00) @db.Decimal(5, 2)
  maintenance_fee_2pct          Decimal?            @default(0) @db.Decimal(15, 2)
  sales_status                  String?             @default("AVAILABLE") @db.VarChar(50)
  direction                     String?             @db.VarChar(50)
  view_description              String?             @db.VarChar(255)
  bedroom_count                 Int?                @default(3)
  bathroom_count                Int?                @default(3)
  svg_coordinates               String?             @db.VarChar(100)
  amenity_usage                 amenity_usage[]
  contracts                     contracts[]
  management_fees               management_fees[]
  occupancies                   occupancies[]
  resident_feedback             resident_feedback[]
  utility_records               utility_records[]
  vehicles                      vehicles[]
  push_subscriptions            push_subscriptions[]
  crm_opportunities             crm_opportunities[]
  sales_bookings                sales_bookings[]
  deposit_receipts              deposit_receipts[]
  sales_cart_items              sales_cart_items[]
  snag_items                    snag_items[]
  pricebook_items               pricebook_items[]
  contract_documents            contract_documents[]
  warranty_claims               warranty_claims[]
  construction_registrations    construction_registrations[]
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model occupancies {
  apartment_id String     @db.VarChar(255)
  resident_id  String     @db.VarChar(255)
  apartments   apartments @relation(fields: [apartment_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  residents    residents  @relation(fields: [resident_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([apartment_id, resident_id])
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model pricing_config_history {
  id                 Int       @id @default(autoincrement())
  config_data        Json
  changed_at         DateTime? @default(now()) @db.Timestamptz(6)
  changed_by_user_id String    @db.VarChar(255)
  users              users     @relation(fields: [changed_by_user_id], references: [id], onDelete: SetNull, onUpdate: NoAction, map: "fk_user")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model resident_accounts {
  resident_id   String    @id @db.VarChar(255)
  password_hash String    @db.VarChar(255)
  created_at    DateTime? @default(now()) @db.Timestamptz(6)
  updated_at    DateTime? @default(now()) @db.Timestamptz(6)
  residents     residents @relation(fields: [resident_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model resident_feedback {
  id                        String     @id @db.VarChar(255)
  resident_id               String     @db.VarChar(255)
  apartment_id              String     @db.VarChar(255)
  content                   String
  image_data                String[]
  status                    String     @default("SUBMITTED") @db.VarChar(50)
  submitted_at              DateTime   @default(now()) @db.Timestamptz(6)
  admin_response_content    String?
  admin_response_image_data String[]
  resolved_by_user_id       String?    @db.VarChar(255)
  resolved_at               DateTime?  @db.Timestamptz(6)
  apartments                apartments @relation(fields: [apartment_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  residents                 residents  @relation(fields: [resident_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users                     users?     @relation(fields: [resolved_by_user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([apartment_id], map: "idx_resident_feedback_apartment_id")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model residents {
  id                  String              @id @db.VarChar(255)
  name                String?             @db.VarChar(255)
  dob                 DateTime?           @db.Date
  id_number           String?             @unique @db.VarChar(255)
  zalo_id             String?             @db.VarChar(255)
  phone_number        String?             @db.VarChar(20)
  is_active           Boolean?            @default(true)
  zalo_name           String?
  email               String?             @db.VarChar(255)
  relationship_status String              @default("FAMILY") @db.VarChar(50)
  can_use_amenities   Boolean             @default(true)
  company_name        String?             @db.VarChar(255)
  buyer_name          String?             @db.VarChar(255)
  tax_code            String?             @db.VarChar(50)
  invoice_address     String?             @db.Text
  amenity_usage       amenity_usage[]
  occupancies         occupancies[]
  resident_accounts   resident_accounts?
  resident_feedback   resident_feedback[]

  @@index([phone_number])
  @@index([email])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model users {
  id                     String                   @id @db.VarChar(255)
  username               String                   @unique @db.VarChar(255)
  password_hash          String                   @db.VarChar(255)
  role                   Int                      @default(1)
  created_at             DateTime                 @default(now()) @db.Timestamptz(6)
  permissions            Json?                    @default("[]")
  fee_config             fee_config[]
  management_fees        management_fees[]
  pricing_config_history pricing_config_history[]
  resident_feedback      resident_feedback[]
  announcements          announcements[]
  userRoles              user_roles[]

  @@index([permissions], map: "idx_users_permissions", type: Gin)
}

model announcements {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title        String    @db.VarChar(500)
  content      String    @db.Text
  summary      String?   @db.VarChar(1000)
  category     String?   @default("general") @db.VarChar(50)
  cover_image  String?   @db.Text
  media_urls   String[]  @default([])
  is_pinned    Boolean   @default(false)
  is_published Boolean   @default(false)
  published_at DateTime? @db.Timestamptz(6)
  scheduled_at DateTime? @db.Timestamptz(6)
  created_by   String    @db.VarChar(255)
  created_at   DateTime  @default(now()) @db.Timestamptz(6)
  updated_at   DateTime  @default(now()) @db.Timestamptz(6)

  users        users     @relation(fields: [created_by], references: [id], onDelete: Cascade)

  @@index([is_published, published_at(sort: Desc)])
  @@index([is_pinned])
  @@index([created_by])
}


/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model utility_records {
  id                      String     @id @db.VarChar(255)
  apartment_id            String     @db.VarChar(255)
  month                   Int
  year                    Int
  electricity_old_reading Decimal    @db.Decimal(10, 2)
  electricity_new_reading Decimal    @db.Decimal(10, 2)
  electricity_consumption Decimal?   @default(dbgenerated("(electricity_new_reading - electricity_old_reading)")) @db.Decimal(10, 2)
  water_old_reading       Decimal    @db.Decimal(10, 2)
  water_new_reading       Decimal    @db.Decimal(10, 2)
  water_consumption       Decimal?   @default(dbgenerated("(water_new_reading - water_old_reading)")) @db.Decimal(10, 2)
  electricity_cost        Decimal    @default(0) @db.Decimal(12, 2)
  water_cost              Decimal    @default(0) @db.Decimal(12, 2)
  pricing_snapshot        Json?      // Snapshot of pricing config at time of record creation
  paid_date               DateTime?  @db.Date
  payment_status          String     @default("UNPAID") @db.VarChar(20)
  email_sent_at           DateTime?  @db.Timestamptz(6)
  vnpt_status             String?    @default("DRAFT") @db.VarChar(20)
  vnpt_fkey               String?    @db.VarChar(100)
  vnpt_invoice_no         String?    @db.VarChar(50)
  vnpt_mccqt              String?    @db.VarChar(100)
  vnpt_publish_date       DateTime?  @db.Timestamptz(6)
  apartments              apartments @relation(fields: [apartment_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([apartment_id, month, year])
}

model customers {
  id             String               @id @db.VarChar(255)
  name           String               @db.VarChar(255)
  phone_number   String               @db.VarChar(20)
  email          String?              @db.VarChar(255)
  address        String?
  id_number      String?              @db.VarChar(255)
  created_at     DateTime?            @default(now()) @db.Timestamptz(6)
  updated_at     DateTime?            @default(now()) @db.Timestamptz(6)
  notes          String?
  transfers_to   contract_transfers[] @relation("NewCustomer")
  transfers_from contract_transfers[] @relation("OldCustomer")
  contracts      contracts[]
}

model contracts {
  id                        String                      @id @db.VarChar(255)
  contract_code             String                      @unique @db.VarChar(100)
  customer_id               String                      @db.VarChar(255)
  apartment_id              String                      @db.VarChar(255)
  contract_type             String?                     @default("FUTURE_HOUSING") @db.VarChar(50)
  total_value               Decimal                     @db.Decimal(15, 2)
  land_price                Decimal?                    @default(0) @db.Decimal(15, 2)
  construction_price        Decimal?                    @default(0) @db.Decimal(15, 2)
  vat_rate                  Decimal?                    @default(8.00) @db.Decimal(5, 2)
  vat_amount                Decimal                     @default(0) @db.Decimal(15, 2)
  maintenance_fee           Decimal                     @default(0) @db.Decimal(15, 2)
  deposit_deducted_amount   Decimal?                    @default(0) @db.Decimal(15, 2)
  clause_18_status          String?                     @default("NORMAL") @db.VarChar(50)
  clause_18_deadline        DateTime?                   @db.Timestamptz(6)
  certificate_number        String?                     @db.VarChar(100)
  handover_deadline         DateTime?                   @db.Date
  finish_standard           String?                     @default("STANDARD") @db.VarChar(50)
  status                    contract_status             @default(DEPOSIT)
  signed_date               DateTime?                   @db.Date
  handover_date             DateTime?                   @db.Date
  created_at                DateTime?                   @default(now()) @db.Timestamptz(6)
  updated_at                DateTime?                   @default(now()) @db.Timestamptz(6)
  handover_completed        Boolean?                    @default(false)
  title_deed_issued         Boolean?                    @default(false)
  title_deed_date           DateTime?                   @db.Timestamptz(6)
  handover_date_actual      DateTime?                   @db.Timestamptz(6)
  approval_workflows        approval_workflows[]
  contract_documents        contract_documents[]
  contract_lifecycle_events contract_lifecycle_events[]
  contract_payments         contract_payments[]
  contract_transfers        contract_transfers[]
  apartments                apartments                  @relation(fields: [apartment_id], references: [id])
  customers                 customers                   @relation(fields: [customer_id], references: [id])
  handover_checklists       handover_checklists[]
  payment_schedules         payment_schedules[]
  snag_items                snag_items[]
  contract_promotions       contract_promotions[]
  commissions               commissions[]
  warranty_claims           warranty_claims[]
  construction_registrations construction_registrations[]

  @@index([customer_id])
  @@index([apartment_id])
}

model contract_transfers {
  id                    String    @id @db.VarChar(255)
  contract_id           String    @db.VarChar(255)
  old_customer_id       String    @db.VarChar(255)
  new_customer_id       String    @db.VarChar(255)
  transfer_date         DateTime  @db.Date
  notary_office         String?   @db.VarChar(255)
  notary_number         String?   @db.VarChar(100)
  notary_date           DateTime? @db.Date
  tax_clearance_date    DateTime? @db.Date
  tax_receipt_number    String?   @db.VarChar(100)
  transfer_code         String?   @db.VarChar(100)
  inherited_paid_amount Decimal?  @default(0) @db.Decimal(15, 2)
  remaining_debt_amount Decimal?  @default(0) @db.Decimal(15, 2)
  approval_status       String?   @default("APPROVED") @db.VarChar(50)
  document_urls         Json?
  notes                 String?
  created_at            DateTime? @default(now()) @db.Timestamptz(6)
  contracts             contracts @relation(fields: [contract_id], references: [id], onDelete: Cascade)
  new_customer          customers @relation("NewCustomer", fields: [new_customer_id], references: [id])
  old_customer          customers @relation("OldCustomer", fields: [old_customer_id], references: [id])

  @@index([contract_id])
  @@index([old_customer_id])
  @@index([new_customer_id])
}

model contract_payments {
  id                     String             @id @db.VarChar(255)
  contract_id            String             @db.VarChar(255)
  installment            Int
  description            String?            @db.VarChar(255)
  milestone_event        String?            @db.VarChar(255)
  base_amount            Decimal?           @default(0) @db.Decimal(15, 2)
  percentage             Decimal?           @default(10.00) @db.Decimal(5, 2)
  due_date               DateTime           @db.Date
  amount                 Decimal            @db.Decimal(15, 2)
  paid_amount            Decimal            @default(0) @db.Decimal(15, 2)
  payment_date           DateTime?          @db.Date
  status                 payment_status     @default(PENDING)
  created_at             DateTime?          @default(now()) @db.Timestamptz(6)
  updated_at             DateTime?          @default(now()) @db.Timestamptz(6)
  late_days              Int?               @default(0)
  late_penalty_rate      Decimal?           @default(0.0005) @db.Decimal(6, 4)
  late_penalty_amount    Decimal?           @default(0) @db.Decimal(15, 2)
  qr_payment_memo        String?            @db.VarChar(100)
  sepay_transaction_id   String?            @db.VarChar(100)
  late_fee               Decimal?           @default(0) @db.Decimal(15, 2)
  days_overdue           Int?               @default(0)
  reminder_sent_at       DateTime?          @db.Timestamptz(6)
  auto_calculated        Boolean?           @default(false)
  payment_schedule_id    String?            @db.VarChar(255)
  early_payment_discount Decimal?           @default(0) @db.Decimal(5, 2)
  is_early_payment       Boolean?           @default(false)
  contracts              contracts          @relation(fields: [contract_id], references: [id], onDelete: Cascade)
  payment_schedules      payment_schedules? @relation(fields: [payment_schedule_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([contract_id])
  @@index([status, due_date], map: "idx_payments_status_due")
}

model contract_documents {
  id            String      @id @db.VarChar(255)
  contract_id   String?     @db.VarChar(255)
  apartment_id  String?     @db.VarChar(255)
  document_name String      @db.VarChar(255)
  file_url      String
  file_size     Int?        @default(0)
  mime_type     String?     @default("application/pdf") @db.VarChar(100)
  doc_type      String?     @default("HDMB_SCAN") @db.VarChar(50) // HDMB_SCAN, DEPOSIT_RECEIPT_SCAN, TRANSFER_AGREEMENT_SCAN, CUSTOMER_ID_SCAN, TAX_RECEIPT_SCAN, TITLE_DEED_SCAN, HANDOVER_MINUTES_SCAN, AMENDMENT_SCAN, OTHER
  uploaded_by   String?     @db.VarChar(255)
  notes         String?
  uploaded_at   DateTime?   @default(now()) @db.Timestamptz(6)
  contracts     contracts?  @relation(fields: [contract_id], references: [id], onDelete: Cascade)
  apartments    apartments? @relation(fields: [apartment_id], references: [id], onDelete: Cascade)

  @@index([contract_id])
  @@index([apartment_id])
  @@index([doc_type])
}

model system_settings {
  key         String   @id @db.VarChar(50)
  value       String?
  description String?
  updated_at  DateTime @default(now()) @updatedAt @db.Timestamptz(6)
}

model email_templates {
  code       String   @id @db.VarChar(50)
  name       String   @db.VarChar(100)
  subject    String
  body       String
  variables  Json?
  updated_at DateTime @default(now()) @updatedAt @db.Timestamptz(6)
}

model contract_lifecycle_events {
  id           String    @id @db.VarChar(255)
  contract_id  String    @db.VarChar(255)
  event_type   String    @db.VarChar(50)
  event_date   DateTime? @default(now()) @db.Timestamptz(6)
  performed_by String?   @db.VarChar(255)
  notes        String?
  metadata     Json?
  created_at   DateTime? @default(now()) @db.Timestamptz(6)
  contracts    contracts @relation(fields: [contract_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([contract_id], map: "idx_lifecycle_contract")
  @@index([event_type], map: "idx_lifecycle_type")
}

model payment_schedules {
  id                String              @id @db.VarChar(255)
  contract_id       String              @db.VarChar(255)
  schedule_name     String?             @db.VarChar(255)
  policy_type       String?             @db.VarChar(50)
  late_fee_rate     Decimal?            @default(0) @db.Decimal(5, 2)
  grace_period_days Int?                @default(0)
  created_at        DateTime?           @default(now()) @db.Timestamptz(6)
  created_by        String?             @db.VarChar(255)
  contract_payments contract_payments[]
  contracts         contracts           @relation(fields: [contract_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([contract_id], map: "idx_payment_schedule_contract")
}

model handover_checklists {
  id                     String    @id @db.VarChar(255)
  contract_id            String    @db.VarChar(255)
  item_name              String    @db.VarChar(255)
  item_order             Int?      @default(0)
  is_required            Boolean?  @default(true)
  is_completed           Boolean?  @default(false)
  completed_at           DateTime? @db.Timestamptz(6)
  completed_by           String?   @db.VarChar(255)
  notes                  String?
  room_area              String?   @default("CHUNG") @db.VarChar(100)
  inspection_passed      Boolean?  @default(true)
  customer_signature     String?   @db.Text
  handover_minutes_code  String?   @db.VarChar(100)
  created_at             DateTime? @default(now()) @db.Timestamptz(6)
  contracts              contracts @relation(fields: [contract_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([contract_id], map: "idx_handover_contract")
}

model snag_items {
  id                   String    @id @db.VarChar(255)
  contract_id          String    @db.VarChar(255)
  apartment_id         String    @db.VarChar(255)
  room_area            String?   @default("PHÒNG KHÁCH") @db.VarChar(100)
  category             String?   @default("KỸ THUẬT") @db.VarChar(100)
  description          String    @db.Text
  severity             String?   @default("MINOR") @db.VarChar(50)
  status               String?   @default("OPEN") @db.VarChar(50)
  photo_urls           String[]  @default([])
  assigned_contractor  String?   @db.VarChar(255)
  sla_deadline         DateTime? @db.Date
  resolved_at          DateTime? @db.Timestamptz(6)
  resolved_by          String?   @db.VarChar(255)
  verified_by_customer Boolean?  @default(false)
  created_at           DateTime? @default(now()) @db.Timestamptz(6)
  updated_at           DateTime? @default(now()) @db.Timestamptz(6)
  contracts            contracts @relation(fields: [contract_id], references: [id], onDelete: Cascade)
  apartments           apartments @relation(fields: [apartment_id], references: [id], onDelete: Cascade)

  @@index([contract_id])
  @@index([apartment_id])
  @@index([status])
}

model approval_workflows {
  id               String     @id @db.VarChar(255)
  request_type     String     @db.VarChar(50)
  contract_id      String?    @db.VarChar(255)
  requested_by     String     @db.VarChar(255)
  requested_at     DateTime?  @default(now()) @db.Timestamptz(6)
  status           String?    @default("PENDING") @db.VarChar(20)
  approver_id      String?    @db.VarChar(255)
  approved_at      DateTime?  @db.Timestamptz(6)
  rejection_reason String?
  request_data     Json?
  created_at       DateTime?  @default(now()) @db.Timestamptz(6)
  contracts        contracts? @relation(fields: [contract_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([contract_id], map: "idx_approval_contract")
  @@index([status], map: "idx_approval_status")
  @@index([request_type], map: "idx_approval_type")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model electricity_pricing {
  id            Int       @id @default(autoincrement())
  tier          Int       @unique
  min_kwh       Int
  max_kwh       Int?
  price_per_kwh Decimal   @db.Decimal(10, 2)
  created_at    DateTime? @default(now()) @db.Timestamptz(6)

